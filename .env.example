# ---------------------------------------------------------------------------
# Monitor Tributário — copie para .env e ajuste. NUNCA versione o .env real.
# ---------------------------------------------------------------------------

# Banco (docker compose usa estes valores)
POSTGRES_USER=monitor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=monitor

# Chaves obrigatórias em produção
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
MT_SECRET_KEY=
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MT_FERNET_KEY=

MT_ENVIRONMENT=dev            # dev | test | staging | prod
MT_DEBUG=false

# Fontes de dados: simulador | manual | integra_contador
MT_CONNECTOR_PROCURACAO=simulador
MT_CONNECTOR_COMPENSACAO=simulador
MT_CONNECTOR_SITUACAO_FISCAL=simulador

# Monitoramento agendado
MT_SCHEDULER_ENABLED=true
MT_SCHEDULER_TIMEZONE=America/Sao_Paulo
MT_MONITORAMENTO_CRON=0 6 * * *
MT_CONSULTA_DESATUALIZADA_DIAS=7
MT_ALERTA_PROCURACAO_DIAS=[30,15,7,0]

# E-mail (opcional)
MT_EMAIL_ENABLED=false
MT_SMTP_HOST=
MT_SMTP_PORT=587
MT_SMTP_USER=
MT_SMTP_PASSWORD=
MT_SMTP_FROM=monitor@suaempresa.com.br

# Camada de IA
MT_IA_ENABLED=true            # motor de regras (determinístico)
MT_IA_LLM_ENABLED=false       # redação opcional por LLM
MT_ANTHROPIC_API_KEY=

# --- Integra Contador (SERPRO) — só preencha com dados do SEU contrato -------
MT_INTEGRA_CONTADOR_ENABLED=false
MT_INTEGRA_CONTADOR_BASE_URL=
MT_INTEGRA_CONTADOR_TOKEN_URL=
MT_INTEGRA_CONTADOR_CONSUMER_KEY=
MT_INTEGRA_CONTADOR_CONSUMER_SECRET=
MT_INTEGRA_CONTADOR_CERT_PATH=/certificados/ecnpj.p12
MT_INTEGRA_CONTADOR_CERT_PASSWORD=
MT_INTEGRA_CONTADOR_CONTRATANTE_CNPJ=
MT_INTEGRA_CONTADOR_AUTOR_PEDIDO_CNPJ=
MT_INTEGRA_CONTADOR_RATE_LIMIT_RPM=30
# Identificadores de serviço do catálogo oficial (não inventar):
MT_IC_SITFIS_ID_SISTEMA=
MT_IC_SITFIS_ID_SERVICO=
MT_IC_PROCURACOES_ID_SISTEMA=
MT_IC_PROCURACOES_ID_SERVICO=
